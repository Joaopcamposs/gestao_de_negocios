# ── Stage 1: Instala dependências (cacheable) ────────────────────────
FROM python:3.11.9-slim AS deps

WORKDIR /gestao_de_negocios

RUN pip install --no-cache-dir uv

# Copia apenas arquivos de dependência para cache de layer
COPY pyproject.toml uv.lock* ./

# Instala somente dependências de produção (sem dev)
RUN uv sync --no-dev --no-install-project

# ── Stage 2: Imagem final leve ───────────────────────────────────────
FROM python:3.11.9-slim

WORKDIR /gestao_de_negocios

# Copia o venv com dependências já instaladas
COPY --from=deps /gestao_de_negocios/.venv .venv/

# Copia código-fonte da aplicação
COPY messagebus/ messagebus/
COPY shared_core/ shared_core/
COPY services/ services/
COPY infra/ infra/
COPY libs/ libs/

ENV PATH="/gestao_de_negocios/.venv/bin:$PATH"
ENV PYTHONPATH=/gestao_de_negocios

# Argumento para definir qual serviço subir
ARG SERVICE_MODULE=services.dentist.main:app
ENV SERVICE_MODULE=${SERVICE_MODULE}

CMD ["sh", "-c", "uvicorn ${SERVICE_MODULE} --host 0.0.0.0 --port 8000 --log-config infra/applications/uvicorn_logging.json"]
